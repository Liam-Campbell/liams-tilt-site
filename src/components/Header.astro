---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Tilts', href: '/tilts' },
  { label: 'Buckets', href: '/buckets' },
  { label: 'Custom Builds', href: '/custom-builds' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'About', href: '/about' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
};
---

<header class="site-header" id="site-header">
  <div class="header-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" aria-label="Future Equipment - Home">
      <span class="logo-mark" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M4 5H20L17 11H8V14H16L13 20H8V22H4V5Z" fill="#F26422"/>
          <line x1="17" y1="11" x2="21" y2="5" stroke="#F26422" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </span>
      <div class="brand-text">
        <span class="brand-name">FUTURE EQUIPMENT</span>
        <span class="brand-tagline">EXCAVATOR ATTACHMENTS NZ</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Call Liam & Get a Quote) -->
    <div class="header-actions">
      <a href="tel:+64210000000" class="call-btn" aria-label="Call Liam directly on 021 000 0000">
        <svg class="phone-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span class="call-text">Call Liam</span>
      </a>

      <a href="/quote" class="btn btn-primary quote-header-btn">
        <span>Get a Quote</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button 
        type="button" 
        class="mobile-toggle" 
        id="mobile-toggle-btn"
        aria-label="Open main menu" 
        aria-expanded="false" 
        aria-controls="mobile-menu"
      >
        <span class="hamburger-line line-1" aria-hidden="true"></span>
        <span class="hamburger-line line-2" aria-hidden="true"></span>
        <span class="hamburger-line line-3" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <nav class="mobile-nav" aria-label="Mobile Navigation">
        <ul class="mobile-nav-list">
          {navItems.map((item) => (
            <li>
              <a 
                href={item.href} 
                class={`mobile-nav-link ${isActive(item.href) ? 'active' : ''}`}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-drawer-actions">
        <a href="tel:+64210000000" class="btn btn-secondary mobile-action-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Call Liam: 021 000 0000</span>
        </a>
        <a href="/quote" class="btn btn-primary mobile-action-btn">
          <span>Get a Fitment Quote</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(18, 20, 22, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-charcoal-border);
    transition: background-color var(--transition-normal);
  }

  .header-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0.85rem var(--container-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Brand Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-charcoal-surface);
    border: 1px solid var(--color-charcoal-border);
    border-radius: var(--radius-sm);
    width: 38px;
    height: 38px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: var(--color-warm-white);
    line-height: 1;
  }

  .brand-tagline {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-steel-grey);
    margin-top: 2px;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 992px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-steel-light);
    position: relative;
    padding: 0.35rem 0;
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-warm-white);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-orange);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .call-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    background-color: var(--color-charcoal-card);
    border: 1px solid var(--color-charcoal-border);
    border-radius: var(--radius-sm);
    color: var(--color-warm-white);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  @media (max-width: 480px) {
    .brand-name {
      font-size: 1.2rem;
    }
    .brand-tagline {
      font-size: 0.58rem;
    }
    .call-btn {
      padding: 0.45rem 0.65rem;
      font-size: 0.85rem;
    }
  }

  .call-btn:hover {
    border-color: var(--color-orange);
    color: var(--color-orange);
  }

  .phone-icon {
    color: var(--color-orange);
  }

  .quote-header-btn {
    display: none;
    padding: 0.5rem 1.15rem;
    font-size: 1.05rem;
    min-height: 40px;
  }

  @media (min-width: 640px) {
    .quote-header-btn {
      display: inline-flex;
    }
  }

  /* Hamburger Button */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-charcoal-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0;
  }

  @media (min-width: 992px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-warm-white);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .mobile-toggle[aria-expanded="true"] .line-1 {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle[aria-expanded="true"] .line-2 {
    opacity: 0;
  }

  .mobile-toggle[aria-expanded="true"] .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Menu Drawer */
  .mobile-menu {
    position: fixed;
    top: 65px;
    left: 0;
    width: 100%;
    height: calc(100vh - 65px);
    background-color: var(--color-charcoal);
    border-top: 1px solid var(--color-charcoal-border);
    display: none;
    overflow-y: auto;
    z-index: 99;
  }

  .mobile-menu.is-open {
    display: block;
  }

  .mobile-menu-inner {
    padding: 2rem var(--container-padding);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-warm-white);
    display: block;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-charcoal-border-subtle);
  }

  .mobile-nav-link.active {
    color: var(--color-orange);
    border-bottom-color: var(--color-orange);
  }

  .mobile-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
  }

  .mobile-action-btn {
    width: 100%;
  }
</style>

<script>
  // Mobile Menu Drawer Interactivity & Keyboard Access
  const toggleBtn = document.getElementById('mobile-toggle-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    const toggleMenu = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const newState = !isExpanded;
      toggleBtn.setAttribute('aria-expanded', String(newState));
      toggleBtn.setAttribute('aria-label', newState ? 'Close main menu' : 'Open main menu');
      mobileMenu.setAttribute('aria-hidden', String(!newState));
      mobileMenu.classList.toggle('is-open', newState);
      document.body.style.overflow = newState ? 'hidden' : '';
    };

    toggleBtn.addEventListener('click', toggleMenu);

    // Close menu when clicking outside or pressing Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
        toggleBtn.focus();
      }
    });

    // Close menu on navigation link clicks
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (toggleBtn.getAttribute('aria-expanded') === 'true') {
          toggleMenu();
        }
      });
    });
  }
</script>
