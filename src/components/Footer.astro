---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-cta-banner">
    <div class="container cta-container">
      <div class="cta-text">
        <span class="eyebrow">Ready to get your machine working?</span>
        <h2 class="cta-title">Built Around Your Digger & Your Job</h2>
        <p class="cta-subtitle">Talk directly with the maker. Get exact fitment confirmation and honest New Zealand manufacturing advice.</p>
      </div>
      <div class="cta-buttons">
        <a href="/quote" class="btn btn-primary btn-lg">
          <span>Get a Fitment Quote</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href="tel:+64210000000" class="btn btn-secondary btn-lg">
          <span>Call 021 000 0000</span>
        </a>
      </div>
    </div>
  </div>

  <div class="container footer-main">
    <div class="footer-grid">
      <!-- Brand & Positioning -->
      <div class="footer-brand-col">
        <a href="/" class="footer-brand-logo" aria-label="Future Equipment">
          <span class="logo-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M4 5H20L17 11H8V14H16L13 20H8V22H4V5Z" fill="#F26422"/>
              <line x1="17" y1="11" x2="21" y2="5" stroke="#F26422" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
          <div class="brand-text">
            <span class="brand-name">FUTURE EQUIPMENT</span>
            <span class="brand-tagline">EXCAVATOR ATTACHMENTS NZ</span>
          </div>
        </a>
        <p class="footer-mission">
          Practical, direct and highly capable attachment manufacturing for New Zealand digger owners, contractors, landscapers and earthmoving operators.
        </p>
        <div class="tagline-badge">
          <span>Built to fit. Built to work.</span>
        </div>
      </div>

      <!-- Product Navigation -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Attachments</h4>
        <ul class="footer-list">
          <li><a href="/tilts">Hydraulic Tilt Hitches</a></li>
          <li><a href="/tilts#single-ram">Single Ram Tilts</a></li>
          <li><a href="/tilts#twin-ram">Twin Ram Tilts</a></li>
          <li><a href="/buckets">Digger Buckets</a></li>
          <li><a href="/buckets#wide-buckets">Wide Mud Buckets</a></li>
          <li><a href="/buckets#trenching">Trenching Buckets</a></li>
          <li><a href="/custom-builds">Custom Attachment Builds</a></li>
          <li><a href="/gallery">In-Action Gallery</a></li>
        </ul>
      </div>

      <!-- Direct Contact & Workshop -->
      <div class="footer-contact-col">
        <h4 class="footer-heading">Direct Contact</h4>
        <ul class="footer-contact-list">
          <li>
            <span class="contact-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            <div class="contact-text">
              <span class="contact-label">Phone:</span>
              <a href="tel:+64210000000" class="contact-value highlight">021 000 0000</a>
            </div>
          </li>
          <li>
            <span class="contact-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </span>
            <div class="contact-text">
              <span class="contact-label">Email:</span>
              <a href="mailto:info@futureequipment.co.nz" class="contact-value">info@futureequipment.co.nz</a>
            </div>
          </li>
          <li>
            <span class="contact-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <div class="contact-text">
              <span class="contact-label">Manufacturing & Dispatch:</span>
              <span class="contact-value">New Zealand · Freight Nationwide</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Service Coverage & Information -->
      <div class="footer-coverage-col">
        <h4 class="footer-heading">NZ Coverage & Support</h4>
        <p class="coverage-desc">
          Supplying attachments to contractors across the North Island (Auckland, Waikato, Bay of Plenty, Hawke’s Bay, Wellington) and South Island (Canterbury, Otago, Southland, Tasman).
        </p>
        <div class="guarantee-box">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Fitment verified before dispatch</span>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} FUTURE EQUIPMENT. All rights reserved. Made in New Zealand.
      </p>
      <p class="disclaimer">
        All product specifications, pin dimensions, and operating weight ranges are subject to confirmation against your excavator model and dipper geometry prior to fabrication.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-charcoal-dark);
    border-top: 1px solid var(--color-charcoal-border);
    margin-top: auto;
  }

  /* Footer CTA Banner */
  .footer-cta-banner {
    background-color: var(--color-charcoal-surface);
    border-bottom: 1px solid var(--color-charcoal-border);
    padding: clamp(2.5rem, 4vw, 4rem) 0;
  }

  .cta-container {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-items: flex-start;
  }

  @media (min-width: 992px) {
    .cta-container {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .cta-title {
    font-size: clamp(2rem, 3vw, 2.75rem);
    margin-bottom: 0.5rem;
  }

  .cta-subtitle {
    font-size: 1.05rem;
    color: var(--color-steel-light);
    max-width: 600px;
    margin-bottom: 0;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Main Footer Section */
  .footer-main {
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 0.9fr 1.1fr 1fr;
    }
  }

  /* Brand Column */
  .footer-brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-charcoal-surface);
    border: 1px solid var(--color-charcoal-border);
    border-radius: var(--radius-sm);
    width: 36px;
    height: 36px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--color-warm-white);
    line-height: 1;
  }

  .brand-tagline {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-steel-grey);
    margin-top: 2px;
  }

  .footer-mission {
    font-size: 0.9rem;
    color: var(--color-steel-light);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .tagline-badge {
    display: inline-block;
    background-color: var(--color-charcoal-surface);
    border: 1px solid var(--color-charcoal-border);
    color: var(--color-orange);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  /* Headings & Lists */
  .footer-heading {
    font-size: 1.2rem;
    color: var(--color-warm-white);
    margin-bottom: 1.25rem;
    letter-spacing: 0.05em;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-list a {
    color: var(--color-steel-light);
    font-size: 0.92rem;
    transition: color var(--transition-fast);
  }

  .footer-list a:hover {
    color: var(--color-orange);
  }

  /* Contact List */
  .footer-contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .contact-icon {
    color: var(--color-orange);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-text {
    display: flex;
    flex-direction: column;
  }

  .contact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-steel-grey);
  }

  .contact-value {
    font-size: 0.95rem;
    color: var(--color-warm-white);
  }

  .contact-value.highlight {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-orange);
  }

  /* Coverage & Guarantee */
  .coverage-desc {
    font-size: 0.88rem;
    color: var(--color-steel-light);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .guarantee-box {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-charcoal-surface);
    border: 1px solid var(--color-charcoal-border);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    color: var(--color-warm-white);
  }

  .guarantee-box svg {
    color: var(--color-success);
  }

  /* Footer Bottom */
  .footer-bottom {
    border-top: 1px solid var(--color-charcoal-border);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--color-steel-grey);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .disclaimer {
    max-width: 600px;
    font-size: 0.75rem;
    color: var(--color-steel-dark);
    margin-bottom: 0;
  }
</style>
