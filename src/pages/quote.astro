---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
---

<BaseLayout
  title="Get a Fitment Quote | FUTURE EQUIPMENT Excavator Attachments NZ"
  description="Request a precision fitment quote for excavator tilt hitches, digger buckets, and custom attachments in New Zealand. Matched to your machine."
>
  <section class="section section-surface page-header-section">
    <div class="container">
      <span class="eyebrow">Direct Machine Fitment</span>
      <h1 class="page-title">Request a Fitment Quote</h1>
      <p class="lead-text page-subtitle">
        Tell us about your digger make, model, and application. Liam will review your pin geometry and provide confirmed pricing, specifications, and lead time.
      </p>
    </div>
  </section>

  <section class="section" id="quote-section">
    <div class="container">
      <div class="quote-layout">
        <!-- Main Form Component -->
        <QuoteForm />

        <!-- Quick Help Sidebar -->
        <aside class="quote-sidebar" aria-label="Quote Assistance">
          <div class="card help-card">
            <span class="card-tag">Prefer To Talk?</span>
            <h3>Call Liam Directly</h3>
            <p>
              Have questions about your auxiliary hydraulic ports, pin centre measurements, or a vintage machine? Give Liam a call on the workshop line.
            </p>
            <a href="tel:+64210000000" class="btn btn-primary btn-block">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>021 000 0000</span>
            </a>
          </div>

          <div class="card guarantee-sidebar-card">
            <h4>What Happens Next?</h4>
            <ol class="next-steps-list">
              <li><strong>Fitment Review:</strong> Liam checks your machine make and model against our technical pin database.</li>
              <li><strong>Confirmed Quote:</strong> We email or call you with exact pricing, steel specs, and delivery time.</li>
              <li><strong>Production:</strong> Steel is cut and welded with zero slop.</li>
            </ol>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-charcoal-border);
  }

  .page-title {
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    max-width: 760px;
    margin-bottom: 0;
  }

  .quote-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .quote-layout {
      grid-template-columns: 1fr 320px;
    }
  }

  .quote-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .help-card {
    background-color: var(--color-charcoal-card);
    border: 1px solid var(--color-charcoal-border);
    border-top: 4px solid var(--color-orange);
  }

  .card-tag {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-orange);
    margin-bottom: 0.25rem;
  }

  .help-card h3 {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .help-card p {
    font-size: 0.9rem;
    color: var(--color-steel-light);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .btn-block {
    width: 100%;
  }

  .guarantee-sidebar-card {
    background-color: var(--color-charcoal-surface);
    border: 1px solid var(--color-charcoal-border);
  }

  .guarantee-sidebar-card h4 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }

  .next-steps-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--color-steel-light);
  }

  .next-steps-list strong {
    color: var(--color-warm-white);
  }
</style>
