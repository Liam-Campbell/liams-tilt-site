---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | FUTURE EQUIPMENT"
  description="The page you are looking for does not exist. Explore our excavator tilt attachments, digger buckets, or get a fitment quote."
>
  <section class="section 404-section">
    <div class="container not-found-container">
      <div class="not-found-card">
        <span class="error-badge">Error 404</span>
        <h1 class="not-found-title">Attachment Not Found</h1>
        <p class="not-found-desc">
          Looks like this pin alignment is off. The page you requested could not be located or may have moved.
        </p>

        <div class="recovery-links">
          <h4>Explore Equipment:</h4>
          <ul class="recovery-nav">
            <li><a href="/" class="btn btn-secondary btn-sm">Home</a></li>
            <li><a href="/tilts" class="btn btn-secondary btn-sm">Hydraulic Tilts</a></li>
            <li><a href="/buckets" class="btn btn-secondary btn-sm">Digger Buckets</a></li>
            <li><a href="/custom-builds" class="btn btn-secondary btn-sm">Custom Builds</a></li>
            <li><a href="/gallery" class="btn btn-secondary btn-sm">In-Action Gallery</a></li>
          </ul>
        </div>

        <div class="not-found-actions">
          <a href="/quote" class="btn btn-primary">
            <span>Get a Fitment Quote</span>
          </a>
          <a href="tel:+64210000000" class="btn btn-dark">
            <span>Call Liam: 021 000 0000</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .not-found-card {
    background-color: var(--color-charcoal-card);
    border: 1px solid var(--color-charcoal-border);
    border-top: 4px solid var(--color-orange);
    border-radius: var(--radius-md);
    padding: clamp(2rem, 5vw, 3.5rem);
    max-width: 680px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-badge {
    display: inline-block;
    background-color: var(--color-orange-subtle);
    border: 1px solid var(--color-orange-border);
    color: var(--color-orange);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }

  .not-found-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin-bottom: 0.75rem;
  }

  .not-found-desc {
    font-size: 1.05rem;
    color: var(--color-steel-light);
    max-width: 480px;
    margin-bottom: 2rem;
  }

  .recovery-links {
    width: 100%;
    margin-bottom: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-charcoal-border);
  }

  .recovery-links h4 {
    font-size: 1rem;
    color: var(--color-steel-grey);
    margin-bottom: 1rem;
  }

  .recovery-nav {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
