---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

const tiltProducts = [
  {
    id: "twin-ram",
    name: "Hydraulic Twin Ram Tilt Hitch",
    category: "Tilts" as const,
    intendedUse: "High-torque tilting and continuous batter grading for mini and compact excavators where maximum holding power and balanced tilt force are required.",
    image: "/images/products/twin-ram-tilt-hitch.webp",
    imageAlt: "Heavy duty twin ram hydraulic tilt hitch attachment",
    tiltMechanism: "Twin Double-Acting Hydraulic Rams (Dual Cylinder Balance)",
    suitableMachines: "0.8t to 14.0t excavators (custom matched to operating weight)",
    configurations: "Direct pin-on mounting or custom top-plate to suit manual/hydraulic quick hitches",
    materials: "High-tensile flame-cut steel plate, heavy chrome-plated cylinder rods, and induction-hardened pivot pins",
    hydraulicReqs: "Single dual-acting auxiliary hydraulic service (pressure line + return, approx 150–210 bar depending on machine size)",
    specs: [
      { label: "Pin Diameter", value: "Custom bored to match machine (25mm, 30mm, 35mm, 40mm, 45mm, 50mm+)", isConfirmed: true },
      { label: "Pin Centres", value: "Machined to exact excavator link arm geometry (85mm – 380mm+)", isConfirmed: true },
      { label: "Dipper / Ear Width", value: "Inside ear spacing custom machined to machine dipper boss width", isConfirmed: true },
      { label: "Attachment Weight", value: "Matched to machine tonnage class (exact kg confirmed upon order)", isConfirmed: false },
      { label: "Tilt Angle", value: "Optimised stroke per machine geometry (Awaiting owner model confirmation)", isConfirmed: false },
      { label: "Hose Protection", value: "Recessed port locations with protective hose routing", isConfirmed: true }
    ]
  },
  {
    id: "single-ram",
    name: "Compact Single Ram Tilt Hitch",
    category: "Tilts" as const,
    intendedUse: "Slim-profile tilting hitch designed for micro and compact mini diggers working in tight trenches, boundary walls, and residential sub-surface drainage.",
    image: "/images/products/twin-ram-tilt-hitch.webp",
    imageAlt: "Compact single ram hydraulic tilt hitch for mini excavators",
    tiltMechanism: "Single Central Heavy-Duty Double-Acting Hydraulic Cylinder",
    suitableMachines: "0.8t to 3.8t mini excavators",
    configurations: "Direct pin-on mounting or dedicated quick-coupler bottom configuration",
    materials: "Solid high-tensile frame, hardened wear bushes, and greaseable pivot points with dust seals",
    hydraulicReqs: "Standard auxiliary circuit (auxiliary relief set to excavator manufacturer specifications)",
    specs: [
      { label: "Pin Diameter", value: "25mm – 40mm (Bored to machine specification)", isConfirmed: true },
      { label: "Pin Centres", value: "Fabricated to factory machine pin centre dimensions", isConfirmed: true },
      { label: "Dipper / Ear Width", value: "Precision-milled ear clearance for snug fitment without shims", isConfirmed: true },
      { label: "Attachment Weight", value: "Lightweight low-profile fabrication (exact kg confirmed per build)", isConfirmed: false },
      { label: "Tilt Angle", value: "Balanced left/right stroke (Awaiting owner confirmation per cylinder spec)", isConfirmed: false },
      { label: "Serviceability", value: "Standard off-the-shelf hydraulic cylinder seals and grease nipples", isConfirmed: true }
    ]
  },
  {
    id: "tilt-bucket",
    name: "Direct-Mount Hydraulic Tilt Bucket",
    category: "Tilts" as const,
    intendedUse: "Integrated tilting mud/clean-up bucket providing direct pin-on attachment geometry for operators who do not require a separate quick hitch.",
    image: "/images/products/heavy-duty-buckets.webp",
    imageAlt: "Direct mount hydraulic tilt bucket for mini and midi excavators",
    tiltMechanism: "Integrated Heavy-Duty Hydraulic Ram on Bucket Headstock",
    suitableMachines: "1.5t to 8.0t excavators",
    configurations: "Available in widths from 900mm up to 1500mm with bolt-on or weld-on reversible cutting edges",
    materials: "Heavy-duty shell plate, hardened cutting edge, and longitudinal bottom wear strips",
    hydraulicReqs: "Single auxiliary service with quick-release couplings",
    specs: [
      { label: "Pin Diameter", value: "Custom bored to exact machine pins (30mm, 35mm, 40mm, 45mm)", isConfirmed: true },
      { label: "Pin Centres", value: "Factory matched to dipper arm and tipping link geometry", isConfirmed: true },
      { label: "Ear Inside Width", value: "Precision dipper arm clearance", isConfirmed: true },
      { label: "Available Widths", value: "900mm, 1000mm, 1200mm, 1400mm, 1500mm (Custom widths on request)", isConfirmed: true },
      { label: "Cutting Edge", value: "High-grade hardened steel (Reversible bolt-on edge option available)", isConfirmed: true },
      { label: "Weight & Capacity", value: "Engineered to keep machine within safe working envelope", isConfirmed: false }
    ]
  }
];
---

<BaseLayout
  title="Excavator Tilt Hitches & Tilt Attachments NZ | FUTURE EQUIPMENT"
  description="Precision New Zealand manufactured hydraulic tilt hitches and direct-mount tilt buckets for mini, compact, and midi excavators. Built to fit your machine."
>
  <!-- Page Header -->
  <section class="section section-surface page-header-section">
    <div class="container">
      <span class="eyebrow">Product Catalog</span>
      <h1 class="page-title">Hydraulic Tilt Attachments</h1>
      <p class="lead-text page-subtitle">
        Purpose-built hydraulic tilting hitches and integrated tilt attachments engineered for New Zealand earthmoving conditions. Fabricated with precision pin geometry to eliminate slop, chatter, and interference.
      </p>
    </div>
  </section>

  <!-- Products List -->
  <section class="section" id="tilt-products">
    <div class="container">
      <div class="section-intro-bar">
        <div class="intro-left">
          <h3>Available Tilt Configurations</h3>
          <p>Select a model to view technical fitment ranges or request a quote for your excavator make.</p>
        </div>
        <a href="/quote?product=Tilt%20Hitch" class="btn btn-primary btn-sm">
          <span>Get a Fitment Quote</span>
        </a>
      </div>

      <div class="products-stack">
        {tiltProducts.map((prod) => (
          <ProductCard
            id={prod.id}
            name={prod.name}
            category={prod.category}
            intendedUse={prod.intendedUse}
            image={prod.image}
            imageAlt={prod.imageAlt}
            tiltMechanism={prod.tiltMechanism}
            suitableMachines={prod.suitableMachines}
            configurations={prod.configurations}
            materials={prod.materials}
            hydraulicReqs={prod.hydraulicReqs}
            specs={prod.specs}
            quoteProductParam={prod.name}
          />
        ))}
      </div>

      <!-- Fitment Sheet Download / Measurement Reference Box -->
      <div class="fitment-sheet-box" id="fitment-guide">
        <div class="sheet-content">
          <div class="sheet-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div class="sheet-details">
            <h4>Ready to Confirm Your Machine's Pin Geometry?</h4>
            <p>
              We measure every excavator individually to confirm pin diameter (mm), centre distance (mm), and dipper width (mm). Enter your machine details directly in our fitment quote builder for a swift response from Liam.
            </p>
          </div>
        </div>
        <div class="sheet-action">
          <a href="/quote" class="btn btn-primary">
            <span>Fill Fitment Form</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-charcoal-border);
  }

  .page-title {
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    max-width: 760px;
    margin-bottom: 0;
  }

  .section-intro-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-charcoal-border);
  }

  @media (min-width: 768px) {
    .section-intro-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .intro-left h3 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .intro-left p {
    font-size: 0.95rem;
    color: var(--color-steel-light);
    margin-bottom: 0;
  }

  .products-stack {
    display: flex;
    flex-direction: column;
  }

  .fitment-sheet-box {
    background-color: var(--color-charcoal-surface);
    border: 1px solid var(--color-charcoal-border);
    border-left: 4px solid var(--color-orange);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .fitment-sheet-box {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .sheet-content {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .sheet-icon {
    color: var(--color-orange);
    background-color: var(--color-charcoal-card);
    border: 1px solid var(--color-charcoal-border);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sheet-details h4 {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
  }

  .sheet-details p {
    font-size: 0.9rem;
    color: var(--color-steel-light);
    margin-bottom: 0;
    line-height: 1.5;
  }

  .sheet-action {
    flex-shrink: 0;
  }
</style>
